// Market Brief (live drivers) for TradingView
// Shows the live-market part of the Market Brief bias on your chart:
// dollar and yields, risk mood (VIX), and the chart's own price trend.
// US data reactions, headlines, and GDELT geopolitics aren't available inside
// TradingView, so those drivers stay on the dashboard.
//
// Add it: Pine Editor > paste this > Save > Add to chart.
// Works on gold (XAUUSD, GOLD, GC), US30 / Dow, and US100 / Nasdaq charts on any timeframe.

//@version=6
indicator("Market Brief (live drivers)", shorttitle = "MB live", overlay = true)

// ------------------------------------------------------------------ inputs
instIn  = input.string("Auto", "Instrument", options = ["Auto", "Gold", "US30", "US100"])
dxySym  = input.symbol("TVC:DXY", "Dollar index")
yldSym  = input.symbol("TVC:US10Y", "US 10-year yield")
vixSym  = input.symbol("TVC:VIX", "VIX")
dowSym  = input.symbol("CBOT_MINI:YM1!", "Dow futures, for gold's sell-everything check")
posIn   = input.string("Top right", "Table position", options = ["Top right", "Bottom right", "Top left", "Bottom left"])
confirmBars = input.int(2, "Bars to confirm bias change alert", minval = 1, maxval = 5)
tgChat  = input.string("", "Telegram chat id (only for webhook alerts)")

// ------------------------------------------------------------------ helpers
f_clamp(x, lo, hi) => math.max(lo, math.min(hi, x))
f_pct(a, b) => (not na(a) and not na(b) and b != 0.0) ? (a - b) / b * 100.0 : na
f_signed(x) => na(x) ? "n/a" : (x >= 0 ? "+" : "") + str.tostring(x, "#0.0")
f_pos(s) => s == "Top right" ? position.top_right : s == "Bottom right" ? position.bottom_right : s == "Top left" ? position.top_left : position.bottom_left

// Rolling hourly stats computed inside request.security(..., "60", ...) so the
// bias matches across all chart timeframes without daily-open resets.
f_24h_stats() =>
    float _pad = nz(close[80]) + nz(time[80])
    float cNow = _pad >= 0 ? close : close
    float c24 = na
    for i = 1 to 80
        if i <= bar_index and (time - time[i]) >= 24 * 3600 * 1000
            c24 := close[i]
            break
    [cNow, c24]

f_own_stats() =>
    float _pad = nz(close[80]) + nz(time[80])
    float cNow = _pad >= 0 ? close : close
    float c24 = na
    float c4 = na
    for i = 1 to 80
        if i > bar_index
            break
        int age = time - time[i]
        if na(c4) and age >= 4 * 3600 * 1000 and age <= 8 * 3600 * 1000
            c4 := close[i]
        if na(c24) and age >= 24 * 3600 * 1000
            c24 := close[i]
            break
    [cNow, c24, c4]

// ------------------------------------------------------------------ which market
tk = str.upper(syminfo.ticker)
autoGold  = str.contains(tk, "XAU") or str.contains(tk, "GOLD") or syminfo.root == "GC" or syminfo.root == "MGC"
autoUs100 = str.contains(tk, "US100") or str.contains(tk, "NAS100") or str.contains(tk, "USTEC") or str.contains(tk, "NDX") or syminfo.root == "NQ" or syminfo.root == "MNQ"
isGold  = instIn == "Gold" or (instIn == "Auto" and autoGold)
isUs100 = not isGold and (instIn == "US100" or (instIn == "Auto" and autoUs100))
mkt = isGold ? "Gold" : isUs100 ? "US100" : "US30"

// ------------------------------------------------------------------ data
[dxyC, dxy24] = request.security(dxySym, "60", f_24h_stats())
[yldC, yld24] = request.security(yldSym, "60", f_24h_stats())
[vixC, vix24] = request.security(vixSym, "60", f_24h_stats())
[dowC, dow24] = request.security(dowSym, "60", f_24h_stats())
[ownC, own24, own4Ref] = request.security(syminfo.tickerid, "60", f_own_stats())
ownAvg5 = request.security(syminfo.tickerid, "D", ta.sma(close, 5))

dxyChg = f_pct(dxyC, dxy24)
yldBp  = (not na(yldC) and not na(yld24)) ? (yldC - yld24) * 100.0 : na
vixChg = f_pct(vixC, vix24)
dowChg = f_pct(dowC, dow24)
own1d  = f_pct(ownC, own24)
own4h  = f_pct(ownC, own4Ref)
ownVs5 = f_pct(ownC, ownAvg5)

// ------------------------------------------------------------------ drivers (same rules as the app)
// Dollar and yields: + = hawkish pressure (dollar up, yields up)
float dySum = 0.0
int dyCnt = 0
if not na(dxyChg)
    dySum += f_clamp(dxyChg / 0.5, -1.5, 1.5)
    dyCnt += 1
if not na(yldBp)
    dySum += f_clamp(yldBp / 5.0, -1.5, 1.5)
    dyCnt += 1
dyScore = dyCnt > 0 ? dySum / dyCnt : 0.0

// Risk mood: + = nervous
vixAdj = na(vixC) ? 0.0 : (vixC >= 25 ? 0.75 : vixC >= 20 ? 0.35 : vixC <= 14 ? -0.3 : 0.0)
risk   = na(vixC) ? 0.0 : f_clamp(f_clamp(nz(vixChg, 0.0) / 10.0, -1.0, 1.0) + vixAdj, -1.5, 1.5)

// Fear only helps gold if gold is holding up. Gold falling with stocks = selling everything.
bool stocksDown = not na(dowChg) and dowChg < 0
bool sellAll    = isGold and risk >= 0.2 and not na(own1d) and own1d <= -0.5 and stocksDown
float goldRisk  = risk < 0.2 ? risk * 1.5 : sellAll ? 0.0 : (not na(own1d) and own1d < -0.2) ? risk * 0.75 : risk * 1.5

// Price trend: last 24h, last 4h, and against the 5-day average (normalized over available components)
s1 = isGold ? 1.5 : isUs100 ? 1.3 : 1.0
s4 = isGold ? 0.6 : isUs100 ? 0.5 : 0.4
s5 = isGold ? 2.0 : isUs100 ? 2.0 : 1.5
float tSum = 0.0
float tW   = 0.0
if not na(own1d)
    tSum += 0.4 * f_clamp(own1d / s1, -1.5, 1.5)
    tW   += 0.4
if not na(own4h)
    tSum += 0.3 * f_clamp(own4h / s4, -1.5, 1.5)
    tW   += 0.3
if not na(ownVs5)
    tSum += 0.3 * f_clamp(ownVs5 / s5, -1.5, 1.5)
    tW   += 0.3
trendN = tW > 0.0 ? tSum / tW : 0.0

float dyMult = isGold ? 2.0 : isUs100 ? 1.8 : 1.5
bool flightToSafety = not isGold and dyScore < -0.2 and risk >= 0.4 and not na(own1d) and own1d <= (isUs100 ? -0.7 : -0.5)
dyPts    = flightToSafety ? 0.0 : -dyScore * dyMult
riskPts  = isGold ? goldRisk : -risk * 2.5
trendPts = trendN * 2.0
score    = f_clamp(dyPts + riskPts + trendPts, -10.0, 10.0)

absS = math.abs(score)
side = score > 0 ? "bullish" : "bearish"
biasText = absS < 1.5 ? "No clear lean" : absS < 4 ? "Leaning " + side : absS < 7 ? (score > 0 ? "Bullish" : "Bearish") : "Strongly " + side

// ------------------------------------------------------------------ table
cBg    = #1C2531
cLine  = #2E3A4A
cText  = #E3E7ED
cMuted = #8E99AA
cBull  = #5BB585
cBear  = #E26A5E
cFlat  = #A9B2BF
cGold  = #D1A84A
cUs30  = #86A9CF
cUs100 = #7FC4B8
mktC   = isGold ? cGold : isUs100 ? cUs100 : cUs30
toneC  = absS < 1.5 ? cFlat : score > 0 ? cBull : cBear
ptsC(x) => math.abs(x) < 0.05 ? cMuted : x > 0 ? cBull : cBear

var table tb = table.new(f_pos(posIn), 3, 6, bgcolor = cBg, frame_color = cLine, frame_width = 1, border_color = cLine, border_width = 1)

if barstate.islast
    table.cell(tb, 0, 0, "Market Brief, live: " + mkt, text_color = mktC, text_halign = text.align_left, text_size = size.small)
    table.merge_cells(tb, 0, 0, 2, 0)
    table.cell(tb, 0, 1, biasText + "  " + f_signed(score), text_color = toneC, text_halign = text.align_left, text_size = size.large)
    table.merge_cells(tb, 0, 1, 2, 1)

    dyNote = flightToSafety ? " (flight to safety)" : ""
    table.cell(tb, 0, 2, "Dollar and yields", text_color = cText, text_halign = text.align_left, text_size = size.small)
    table.cell(tb, 1, 2, "DXY " + f_signed(dxyChg) + "%, 10Y " + f_signed(yldBp) + " bp" + dyNote, text_color = cMuted, text_halign = text.align_left, text_size = size.small)
    table.cell(tb, 2, 2, f_signed(dyPts), text_color = ptsC(dyPts), text_size = size.small)

    vixNote = sellAll ? ", selling everything" : ""
    vixTxt  = na(vixC) ? "n/a" : "VIX " + str.tostring(vixC, "#0.0") + ", " + f_signed(vixChg) + "%" + vixNote
    table.cell(tb, 0, 3, "Risk mood", text_color = cText, text_halign = text.align_left, text_size = size.small)
    table.cell(tb, 1, 3, vixTxt, text_color = cMuted, text_halign = text.align_left, text_size = size.small)
    table.cell(tb, 2, 3, f_signed(riskPts), text_color = ptsC(riskPts), text_size = size.small)

    avgTxt = na(ownVs5) ? "avg n/a" : (ownVs5 >= 0 ? "above" : "below") + " 5-day avg"
    table.cell(tb, 0, 4, "Price trend", text_color = cText, text_halign = text.align_left, text_size = size.small)
    table.cell(tb, 1, 4, f_signed(own1d) + "% 24h, " + f_signed(own4h) + "% 4h, " + avgTxt, text_color = cMuted, text_halign = text.align_left, text_size = size.small)
    table.cell(tb, 2, 4, f_signed(trendPts), text_color = ptsC(trendPts), text_size = size.small)

    table.cell(tb, 0, 5, "US data, headlines and geopolitics are on the dashboard", text_color = cMuted, text_halign = text.align_left, text_size = size.tiny)
    table.merge_cells(tb, 0, 5, 2, 5)

// ------------------------------------------------------------------ alerts
// Fires after a new bias label holds for `confirmBars` consecutive bar closes.
var string announcedBias = ""
var string pendingBias   = ""
var int    pendingCount  = 0
if barstate.isconfirmed
    if announcedBias == ""
        announcedBias := biasText
    else if biasText == announcedBias
        pendingBias  := ""
        pendingCount := 0
    else
        if biasText == pendingBias
            pendingCount += 1
        else
            pendingBias  := biasText
            pendingCount := 1
        if pendingCount >= confirmBars
            msg = mkt + " live bias: " + announcedBias + " to " + biasText + " (" + f_signed(score) + ")"
            payload = tgChat == "" ? msg : '{"chat_id": "' + tgChat + '", "text": "' + msg + '"}'
            alert(payload, alert.freq_once_per_bar_close)
            announcedBias := biasText
            pendingBias   := ""
            pendingCount  := 0

// Score in the data window (and as {{plot_0}} in alert messages)
plot(score, "Live bias score", display = display.data_window)
